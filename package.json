{
  "name": "@linanw/homebridge-tuya-platform",
  "version": "2.6.1",
  "description": "Tuya Open API integration for Homebridge with optional Matter support.",
  "main": "index.js",
  "scripts": {
    "test": "mocha test/datautil.test.js && node --test test/matter_devices.test.js test/matter_bridge.test.js test/matter_integration.test.js test/wirelessswitch.test.js test/platform_errors.test.js test/package.test.js",
    "dev": "homebridge -D -U ./config/ -P .",
    "prepublishOnly": "npm test"
  },
  "files": [
    "index.js",
    "lib/",
    "util/",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "config.schema.json"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "homebridge-plugin",
    "supports-matter",
    "matter"
  ],
  "author": "linanw",
  "license": "MIT",
  "homepage": "https://github.com/linanw/tuya-homebridge",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/linanw/tuya-homebridge.git"
  },
  "bugs": {
    "url": "https://github.com/linanw/tuya-homebridge/issues"
  },
  "engines": {
    "node": ">=22.0.0",
    "homebridge": ">=1.11.4"
  },
  "devDependencies": {
    "homebridge": "2.4.0",
    "mocha": "12.0.3"
  },
  "dependencies": {
    "@clubedaentrega/cipher": "^1.0.0",
    "aes-decrypter": "^3.1.2",
    "axios": "^0.21.1",
    "chai": "^4.3.4",
    "crypto-js": "^4.0.0",
    "js-base64": "^3.6.1",
    "mqtt": "^4.2.6",
    "string-cipher": "^1.0.8",
    "text-encoding": "^0.7.0",
    "uuid": "^8.3.2"
  }
}
